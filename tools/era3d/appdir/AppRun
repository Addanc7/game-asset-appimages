#!/bin/bash
# Era3D AppImage launcher
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
export APPDIR

export PATH="$APPDIR/usr/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Never let the host Python env leak into the bundled interpreter
unset PYTHONHOME
unset PYTHONPATH

# User-writable data (models, caches) — Era3D weights download here on first run
export ERA3D_DATA="${ERA3D_DATA:-$HOME/.local/share/era3d-appimage}"
export HF_HOME="$ERA3D_DATA/hf"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TORCH_HOME="$ERA3D_DATA/torch"

# 8GB-VRAM perf knobs (overridable)
export CUDA_MODULE_LOADING="${CUDA_MODULE_LOADING:-LAZY}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

mkdir -p "$ERA3D_DATA"

exec "$APPDIR/usr/bin/python3.11" "$APPDIR/usr/share/era3d/era3d_app.py" "$@"
